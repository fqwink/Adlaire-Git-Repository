# Copy this file to deploy.env and fill only environment-specific values.
# Do not commit deploy.env.

DEPLOY_HOST=example.internal
DEPLOY_USER=adlaire-deploy
DEPLOY_PORT=22

APP_ROOT=/opt/adlaire-git-repository
SYSTEM_ROOT=/opt/adlaire-git-repository/system
SHARED_ROOT=/opt/adlaire-git-repository/shared
SERVICE_NAME=adlaire-git-repository

RELEASE_VERSION=v.2.10
ARTIFACT_PATH=dist/adlaire-git-repo
HEALTH_URL=http://127.0.0.1:8080/health

RELEASES_DIR=/opt/adlaire-git-repository/system/releases
CURRENT_LINK=/opt/adlaire-git-repository/system/current
DEPLOY_LOG=/opt/adlaire-git-repository/shared/logs/deploy.log
MANIFEST_ROOT=/opt/adlaire-git-repository/shared/manifests

REMOTE_ENV_FILE=/opt/adlaire-git-repository/shared/config/adlaire.env
REMOTE_DATABASE_PATH=/opt/adlaire-git-repository/shared/data/database/adlaire.libsql
REMOTE_REPOSITORY_ROOT=/opt/adlaire-git-repository/shared/data/repositories
REMOTE_SECRETS_DIR=/opt/adlaire-git-repository/shared/secrets
REMOTE_LOG_DIR=/opt/adlaire-git-repository/shared/logs
REMOTE_BACKUP_ROOT=/opt/adlaire-git-repository/shared/backups
