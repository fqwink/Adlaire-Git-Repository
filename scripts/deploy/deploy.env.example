# Copy this file to deploy.env and fill only environment-specific values.
# Do not commit deploy.env.

DEPLOY_HOST=example.internal
DEPLOY_USER=adlaire-deploy
DEPLOY_PORT=22

APP_ROOT=/opt/adlaire-git-repository
SERVICE_NAME=adlaire-git-repository

RELEASE_VERSION=v.1.9
ARTIFACT_PATH=dist/adlaire-git-repo
HEALTH_URL=http://127.0.0.1:8080/health

REMOTE_ENV_FILE=/opt/adlaire-git-repository/shared/config/adlaire.env
REMOTE_DATABASE_PATH=/opt/adlaire-git-repository/shared/data/database/adlaire.libsql
REMOTE_REPOSITORY_ROOT=/opt/adlaire-git-repository/shared/data/repositories
